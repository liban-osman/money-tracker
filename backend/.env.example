# Copy this file to .env and fill in real values. .env is git-ignored.

PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox | production
PLAID_ENV=sandbox

DATABASE_URL=sqlite:///./money_tracker.db

# Comma-separated origins allowed to call the API (the Vite dev server)
CORS_ORIGINS=http://localhost:5173
PLAID_REDIRECT_URI=http://localhost:5173/
